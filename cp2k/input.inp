&EXT_RESTART
#RESTART_FILE_NAME PROJECT-1.restart 
#RESTART_COUNTERS F
##RESTART_THERMOSTAT F
##RESTART_VEL T
##RESTART_CONSTRAINT F
##RESTART_DEFAULT F
##RESTART_POS T
&END EXT_RESTART

&GLOBAL
# PROJECT ov-4h2o-v
 RUN_TYPE ENERGY
 PRINT_LEVEL MEDIUM
&END GLOBAL

&MOTION
 &GEO_OPT
  MAX_ITER  1500
  MAX_DR    1.E-3
#  RMS_DR    3.E-4
  MAX_FORCE 4.E-4
#  RMS_FORCE 3.E-5
  OPTIMIZER BFGS
 &END GEO_OPT
&END MOTION

&FORCE_EVAL
#STRESS_TENSOR ANALYTICAL
 &DFT
BASIS_SET_FILE_NAME  /sh3/ysuanbase/home/yeesuan18026/cp2k_potential/potential/BASIS_SET
POTENTIAL_FILE_NAME  /sh3/ysuanbase/home/yeesuan18026/cp2k_potential/potential/GTH_POTENTIALS
&PRINT
&AO_MATRICES
#SECTION_PARAMETERS ON
OVERLAP T
NDIGITS 16
&END
&PDOS
NLUMO -1
&END PDOS
&END
  # LSD
#  MULTIPLICITY 3
  PLUS_U_METHOD LOWDIN
  &MGRID
#   NGRIDS 5
   &RS_GRID
   # DISTRIBUTION_TYPE REPLICATED
   &END RS_GRID
   CUTOFF 500
 #  REL_CUTOFF 50
 COMMENSURATE
 &END MGRID
  &QS
   EXTRAPOLATION ASPC
   EXTRAPOLATION_ORDER 3
   EPS_DEFAULT 1.0E-12
  &END QS
  &SCF
IGNORE_CONVERGENCE_FAILURE
   ADDED_MOS -1
   EPS_SCF 2.0E-6
   MAX_SCF 100
   SCF_GUESS RESTART 
   &OUTER_SCF
    MAX_SCF 5
    OPTIMIZER DIIS
    STEP_SIZE 0.15
    EPS_SCF 2.0E-6
   &END OUTER_SCF
   CHOLESKY INVERSE
   &SMEAR  ON
    METHOD FERMI_DIRAC 
    ELECTRONIC_TEMPERATURE [K] 300
   &END SMEAR
   &DIAGONALIZATION
    ALGORITHM STANDARD
   &END DIAGONALIZATION
   &MIXING
    METHOD BROYDEN_MIXING
    ALPHA   0.1
    BETA    1.5
    NBROYDEN  8
 &END 
 #  &OT T 
 #   MINIMIZER DIIS
 #   PRECONDITIONER FULL_ALL
 #   ENERGY_GAP 0.01
 #  &END OT
  &END SCF
  &XC
 &VDW_POTENTIAL
       POTENTIAL_TYPE PAIR_POTENTIAL
       &PAIR_POTENTIAL
         TYPE DFTD3(BJ) #DFTD3
         PARAMETER_FILE_NAME  /sh3/ysuanbase/home/yeesuan18026/cp2k_potential/potential/dftd3.dat
         REFERENCE_FUNCTIONAL PBE
       &END PAIR_POTENTIAL
    &END VDW_POTENTIAL
   &XC_FUNCTIONAL PBE
   &END XC_FUNCTIONAL
   &XC_GRID
    XC_SMOOTH_RHO NN10 
    XC_DERIV SPLINE2_smooth
   &END XC_GRID
 #    &VDW_POTENTIAL
 #      POTENTIAL_TYPE   PAIR_POTENTIAL
 #    &END VDW_POTENTIAL
  &END XC
 &END DFT
 &SUBSYS
  &CELL
  ABC  10  10  10
  &END CELL
   &COORD
  @include coord.xyz
 &END COORD
#  &KIND Ti
#   BASIS_SET  DZVP-MOLOPT-SR-GTH
#   POTENTIAL GTH-PBE-q12
